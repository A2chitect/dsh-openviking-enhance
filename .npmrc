# The DSH desktop sandbox cannot write to ~/Library/pnpm or ~/.npm, so the
# pnpm store and npm cache are kept inside the project (both are gitignored).
# Keep this file committed: a fresh clone outside the sandbox can delete these
# two lines and use the machine defaults.
store-dir=.pnpm-store
cache-dir=.npm-cache

# The DSH runtime packages are published under the `next` dist-tag while the
# desktop app tracks 0.2.0-rc.x; run installs with an explicit version/tag.
# Example: pnpm add -D @deepseek-ai/dsh-client-ui-slots@0.2.0-rc.2
