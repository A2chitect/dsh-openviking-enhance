{
  "name": "dsh-openviking-enhance",
  "version": "0.3.0",
  "description": "OpenViking in the DSH web GUI: Studio panel, commit status pill and diff browser, per-turn recall explanation, recall/health/Doctor tabs, viking:// preview, /viking commands, Explore search/rules/skills/Experience, and opt-in curation with snapshot undo, forced commits, an Activity tab and named identity profiles.",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "icon.svg",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES",
    "PROVENANCE.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0-rc.2 <1.0.0-0 || >=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build",
    "check:package": "node scripts/check-package.mjs",
    "smoke": "node scripts/smoke-client.mjs && node scripts/smoke-host.mjs",
    "test": "pnpm run check && pnpm run check:package && pnpm run check:independence && pnpm run unit && pnpm run smoke",
    "unit": "node --test",
    "release": "node scripts/release.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "verify:install": "node scripts/verify-install.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.7.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <1.0.0-0 || >=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.0-rc.2 <1.0.0-0 || >=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A2chitect/dsh-openviking-enhance.git"
  },
  "bugs": {
    "url": "https://github.com/A2chitect/dsh-openviking-enhance/issues"
  },
  "homepage": "https://github.com/A2chitect/dsh-openviking-enhance#readme",
  "author": "A2chitect",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "openviking",
    "memory",
    "observability"
  ]
}
